{
  "name": "pi-markitdown",
  "version": "1.0.0",
  "description": "pi extension wrapping markitdown CLI",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dnevb/pi-markitdown.git"
  },
  "files": [
    "extensions/",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check . --write"
  },
  "pi": {
    "extensions": [
      "extensions/pi-markitdown/index.ts"
    ]
  },
  "devDependencies": {
    "vitest": "^4.0.18",
    "@biomejs/biome": "^2.4.13"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "typebox": "*"
  }
}
